# Sherpa — v1 dev/deploy environment. Copy to `.env` and fill secrets.
# Authoritative config contract: docs/contracts/config-and-secrets.md (ADR-019).
# Values marked SECRET must never be logged or committed.

# ── App ──
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ── Postgres ──
POSTGRES_USER=sherpa
POSTGRES_PASSWORD=sherpa            # SECRET (dev only; change for real deploys)
POSTGRES_DB=sherpa
DATABASE_URL=postgresql+asyncpg://sherpa:sherpa@postgres:5432/sherpa

# ── Redis (queue + streams + locks) ──
REDIS_URL=redis://redis:6379/0

# ── Security / secrets (ADR-019) ──
APP_SECRET=change-me                # SECRET — session signing
KEK=change-me-32-byte-base64        # SECRET — key-encryption-key for AEAD token storage
KEK_ID=kek-1

# ── Owner login (v1 is single-user) ──
OWNER_EMAIL=owner@localhost
OWNER_PASSWORD=sherpa-dev-password  # SECRET — change before exposing the stack

# ── Object storage (personal Drive / files, ADR-012/030) ──
STORAGE_KIND=minio                  # minio | memory (offline dev/tests)
MINIO_ROOT_USER=sherpa
MINIO_ROOT_PASSWORD=sherpa-dev-secret   # SECRET (dev only)
MINIO_BUCKET=sherpa-files

# ── Code execution sandbox (ADR-025/039) ──
SANDBOX_KIND=docker                 # docker | disabled (the worker mounts docker.sock)

# ── Model provider ──
# Default = mock (offline, deterministic). Either set a process-wide provider here,
# or leave it and configure model sources in the UI (Settings → Models, ADR-041).
PROVIDER_KIND=mock
# PROVIDER_KIND=openai_compatible
# PROVIDER_BASE_URL=http://host.docker.internal:4000
# PROVIDER_MODEL=claude-sonnet-4.6
# PROVIDER_API_KEY=                 # SECRET

# ── Embeddings (ADR-032; decoupled from the chat provider) ──
# Default = mock (offline, deterministic). For real semantic memory, run the
# bundled ollama container (`docker compose --profile embeddings up`) and set:
# EMBEDDING_KIND=ollama
# EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# Optional external /v1/embeddings override instead of the bundled ollama:
# EMBEDDING_KIND=openai_compatible
# EMBEDDING_BASE_URL=http://host.docker.internal:4000
# EMBEDDING_API_KEY=               # SECRET

# ── Gmail connector (M2; v1 main line) ──
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=              # SECRET
# GMAIL_REDIRECT=http://localhost:8000/connectors/gmail/oauth/callback

# ── Agentic email (milestone 5, AgentMail) ──
EMAIL_KIND=recording                # recording (no real send) | agentmail
# AGENTMAIL_API_KEY=                # SECRET
# AGENTMAIL_INBOX_ID=
# AGENTMAIL_WEBHOOK_SECRET=         # SECRET (whsec_...)
# AGENTMAIL_OWNER_EMAIL=            # trusted inbound sender (your address)

# ── Agent observability / tracing (ADR-033) ──
# Off by default (zero overhead). Keep these HERE rather than exporting them in a
# shell: compose reads this file via `--env-file .env`, so a shell-only export is
# lost on the next `up`/rebuild and tracing stops collecting silently. web+worker
# log one startup line stating whether tracing is on and where spans go.
# For the bundled Phoenix UI (http://localhost:6006):
#   docker compose -f infra/docker-compose.yml --env-file .env --profile observability up -d
#   then set OTEL_ENABLED=true + OTEL_EXPORTER_OTLP_ENDPOINT below and restart web+worker.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:4317
OTEL_CAPTURE_MESSAGE_CONTENT=false  # opt-in, PII: puts prompt/completion text on spans
OTEL_TRACES_SAMPLER=always_on

# ── Notification defaults (safe v1 defaults; see config contract) ──
DIGEST_TIME=08:00
QUIET_HOURS=22:00-08:00
DAILY_CAP=6
